              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "description": "Conflict test: use this after the valid registration request. The backend currently returns 409 Conflict when the email is already registered."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 409 Conflict', function () { pm.response.to.have.status(409); });",
              "pm.test('Response is valid JSON when returned', function () {",
              "    if (pm.response.text()) pm.expect(pm.response.json()).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
