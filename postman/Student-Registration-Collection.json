{
  "info": {
    "_postman_id": "4e8c1f3a-7b5d-4c92-a9f1-2d6e8b0c41a7",
    "name": "Student Management System – Student Registration Testing",
    "description": "Postman tests for registering students through the Student Management System API. Run the valid registration request before the duplicate-email request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Student – Valid Data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Kamal\",\n  \"lastName\": \"Perera\",\n  \"email\": \"kamal.perera@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "description": "Registers a student with valid first name, last name, and email data. Run this request first so the returned ID can be saved as studentId."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "let data;",
              "pm.test('Response is valid JSON', function () {",
              "    data = pm.response.json();",
              "    pm.expect(data).to.be.an('object');",
              "});",
              "pm.test('Response contains a numeric id', function () {",
              "    pm.expect(data).to.have.property('id');",
              "    pm.expect(data.id).to.be.a('number');",
              "});",
              "pm.test('Student fields match the request', function () {",
              "    pm.expect(data.firstName).to.eql('Kamal');",
              "    pm.expect(data.lastName).to.eql('Perera');",
              "    pm.expect(data.email).to.eql('kamal.perera@example.com');",
              "});",
              "pm.test('Response Content-Type is application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/i);",
              "});",
              "pm.environment.set('studentId', data.id);"
            ]
          }
        }
      ]
    },
